{
  "name": "@local/df-observer",
  "version": "0.1.95",
  "private": true,
  "type": "module",
  "description": "Watches Dwarf Fortress through the DF MCP server and tells the model what matters unprompted: bounded briefings, to-dos with plugin-run acceptance tests, alerts that wake the agent, pause attribution, and a live panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "observer.js",
    "model.js",
    "brief.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "deploy.sh",
    "icon.svg"
  ],
  "dependencies": {
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
